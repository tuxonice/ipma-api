{
    "name": "tuxonice/ipma-api",
    "type": "library",
    "homepage": "https://github.com/tuxonice/ipma-api",
    "description": "PHP Package to manage IPMA API (https://api.ipma.pt/)",
    "support": {
        "issues": "https://github.com/tuxonice/ipma-api/issues",
        "source": "https://github.com/tuxonice/ipma-api"
    },
    "keywords": ["ipma", "weather", "forecast", "portugal", "api-client"],
    "license" : "MIT",
    "authors": [
        {
            "name": "Helder Correia",
            "email": "tuxboy@tlab.pt",
            "role" : "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Tlab\\IpmaApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tlab\\Tests\\": "tests/Unit/"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "league/csv": "^9.14",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4",
        "squizlabs/php_codesniffer": "^3.8",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5",
        "symfony/cache": "^6.4"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "phpcs",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "minimum-stability" : "stable"
}
